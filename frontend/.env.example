# Copy this file to .env and fill in the values.
# .env must NOT be committed to git.

# Backend API base URL (leave blank for local proxy or set to deployed backend URL e.g. https://your-backend.railway.app)
VITE_API_BASE_URL=http://localhost:8080

# Razorpay publishable (test) key - safe to expose to the browser
VITE_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
